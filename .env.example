# Main application database (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Optional: bring your own key via environment instead of the Settings UI.
# When unset and no key is stored in Settings, Servo runs in deterministic
# mock mode so the whole demo works offline.
#
# Used when the provider is "anthropic" (Anthropic API or any
# Anthropic-compatible endpoint, e.g. Z.AI via the base URL setting):
# ANTHROPIC_API_KEY=sk-ant-...
#
# Used when the provider is "openai" (any OpenAI-compatible endpoint:
# OpenAI, Azure OpenAI, Z.AI, vLLM…; keyless local endpoints like Ollama
# only need the base URL):
# OPENAI_API_KEY=sk-...
# Used when the provider is "zai" (Z.AI GLM, first-class provider):
# ZAI_API_KEY=...

# Optional: real GitHub integration for github_create_repo / github_open_pr.
# Takes precedence over the token stored in Settings. Without a token the
# GitHub tools run simulated.
# GITHUB_TOKEN=github_pat_...

# Optional: read-only Azure integration for azure_list_resources.
# A service principal with the Reader role on the subscription is enough.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=...
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional: outbound email notifications. Takes precedence over the SMTP URL
# stored in Settings. Enable the switch in Settings → Email notifications.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# Base URL used in notification links (defaults to http://localhost:3000):
# APP_URL=https://servo.example.com

# Optional: shared secret for the inbound-email webhook
# (POST /api/inbound/email, sent as the x-servo-token header or ?token=).
# Enable the switch in Settings → Integrations → Inbound email.
# INBOUND_EMAIL_SECRET=a-long-random-string

# Optional: lets a scheduler run the SLA breach scan without a session
# (POST /api/sla/scan with the x-servo-token header).
# SLA_SCAN_SECRET=another-long-random-string
